# ⚠️  NOT ACTIVE IN PRODUCTION — Netlify/Cloudflare Pages `_headers` syntax.
#
# Verified against production on 2026-08-30:
#   • GET /admin           → 200 with NO X-Robots-Tag response header
#   • GET /sitemap.xml     → content-type: text/xml (this file asks for
#                            application/xml) and no Cache-Control
#   • response headers show `server: cloudflare` + `x-deployment-id`,
#     i.e. the Lovable publish pipeline, which does not read this file.
#
# Kept because it is correct for Netlify and Cloudflare Pages, and would take
# effect immediately if hosting moves there. Until then, treat it as a
# statement of intent, not as a control that is running.
#
# The controls that ARE running today:
#   • noindex in the initial HTML for private routes  → scripts/prerender.mjs
#   • crawl directives                                → public/robots.txt
#   • access control                                  → Supabase auth + RLS
#
# Admin routes - prevent indexing at server level
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow

# Auth routes - prevent indexing
/auth
  X-Robots-Tag: noindex, nofollow

# Patient/intake routes - prevent indexing
/intake/*
  X-Robots-Tag: noindex, nofollow
/join/*
  X-Robots-Tag: noindex, nofollow
/patient-invite/*
  X-Robots-Tag: noindex, nofollow
/portal
  X-Robots-Tag: noindex, nofollow
/verify-booking
  X-Robots-Tag: noindex, nofollow
/verify-email
  X-Robots-Tag: noindex, nofollow
/magic
  X-Robots-Tag: noindex, nofollow

# Sitemap - correct content type
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# All public pages - good caching
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
